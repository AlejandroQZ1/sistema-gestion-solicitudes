@page
@model AdministracionSoluciones.Pages.Login.IndexModel
@{
    // El login no usa la plantilla con menú, porque el usuario aún no ha iniciado sesión
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - SIGES</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body class="login-fondo">

    <main class="login-tarjeta">

        <div class="login-encabezado">
            <img src="~/img/logo-siges.svg" alt="Logo SIGES" class="login-logo" />
            <h1>SIGES</h1>
            <p>Sistema de Gestión de Solicitudes</p>
        </div>

        @if (Model.Mensaje != null)
        {
            <div class="alert alert-warning" role="alert">@Model.Mensaje</div>
        }

        @if (Model.Error != null)
        {
            <div class="alert alert-danger" role="alert">@Model.Error</div>
        }

        <form method="post" autocomplete="off">
            <div class="mb-3">
                <label asp-for="Input.NombreUsuario" class="form-label">Usuario</label>
                <input asp-for="Input.NombreUsuario" class="form-control" placeholder="Ingrese su usuario" autofocus />
            </div>

            <div class="mb-4">
                <label asp-for="Input.Contrasena" class="form-label">Contraseña</label>
                <input asp-for="Input.Contrasena" type="password" class="form-control" placeholder="Ingrese su contraseña" />
            </div>

            <button type="submit" class="btn btn-login w-100">Aceptar</button>
        </form>

    </main>

</body>
</html>
