
@page
@model AdministracionSoluciones.Pages.Desgloses.IndexModel

@{
    ViewData["Title"] = "Desgloses de solicitudes";
}

<div class="container-fluid pagina-siges">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="h3 mb-1">Administración de desgloses</h2>

            @if (Model.SolicitudSeleccionada != null)
            {
                <p class="text-muted mb-0">
                    Solicitud:
                    <strong>@Model.SolicitudSeleccionada.ConsecutivoOficio</strong>
                    — @Model.SolicitudSeleccionada.Titulo
                </p>
            }
            else
            {
                <p class="text-muted mb-0">
                    Consulta y administra los costos y las horas planificadas por período.
                </p>
            }
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (Model.SolicitudId.HasValue)
            {
                <a asp-page="/Solicitudes/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Volver a solicitudes
                </a>

                <a asp-page="Create"
                   asp-route-solicitudId="@Model.SolicitudId"
                   class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Nuevo desglose
                </a>
            }
            else
            {
                <a asp-page="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Nuevo desglose
                </a>
            }
        </div>
    </div>

    <div class="tarjeta-siges">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3">
            <div>
                <h3 class="h5 mb-1">Desgloses registrados</h3>
                <span class="text-muted small">
                    Total: @Model.TotalRegistros registros
                </span>
            </div>

            <span class="badge text-bg-secondary">
                Página @Model.PaginaActual de @Model.TotalPaginas
            </span>
        </div>

        <div class="table-responsive">
            <table class="table tabla-siges align-middle mb-0">
                <thead>
                    <tr>
                        <th>Solicitud</th>
                        <th>Período</th>
                        <th class="text-end">Horas</th>
                        <th class="text-end">Monto base</th>
                        <th class="text-end">IVA (13%)</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">% cobro</th>
                        <th>Observaciones</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Desgloses.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No se encontraron registros de desgloses.
                            </td>
                        </tr>
                    }

                    @foreach (var d in Model.Desgloses)
                    {
                        <tr>
                            <td>
                                <strong>
                                    @(d.ConsecutivoOficio ?? $"Solicitud #{d.SolicitudID}")
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(d.TituloSolicitud))
                                {
                                    <div class="text-muted small" title="@d.TituloSolicitud">
                                        @d.TituloSolicitud
                                    </div>
                                }
                            </td>

                            <td class="text-nowrap">@d.NombreMes @d.Anio</td>
                            <td class="text-end text-nowrap">@d.Horas.ToString("N1") h</td>
                            <td class="text-end text-nowrap">@d.Monto.ToString("C2")</td>
                            <td class="text-end text-nowrap">@d.IVA.ToString("C2")</td>
                            <td class="text-end fw-bold text-nowrap">@d.Total.ToString("C2")</td>
                            <td class="text-center">@d.PorcentajeCobro.ToString("N0")%</td>

                            <td>
                                @(string.IsNullOrWhiteSpace(d.Observaciones)
                                    ? "—"
                                    : d.Observaciones)
                            </td>

                            <td class="text-center text-nowrap">
                                <a asp-page="Edit"
                                   asp-route-id="@d.DesgloseID"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Editar desglose">
                                    <i class="bi bi-pencil-square"></i>
                                    Editar
                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger btn-confirmar-eliminar"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalConfirmarEliminar"
                                        data-id="@d.DesgloseID"
                                        data-descripcion="Desglose de @d.NombreMes @d.Anio por @d.Total.ToString("C2")"
                                        title="Eliminar desglose">
                                    <i class="bi bi-trash"></i>
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-3">
                <span class="text-muted small">
                    Mostrando @Model.Desgloses.Count() de @Model.TotalRegistros registros
                </span>

                <nav aria-label="Navegación de páginas">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="Index"
                               asp-route-solicitudId="@Model.SolicitudId"
                               asp-route-pagina="@(Model.PaginaActual - 1)">
                                Anterior
                            </a>
                        </li>

                        @for (int p = 1; p <= Model.TotalPaginas; p++)
                        {
                            <li class="page-item @(p == Model.PaginaActual ? "active" : "")">
                                <a class="page-link"
                                   asp-page="Index"
                                   asp-route-solicitudId="@Model.SolicitudId"
                                   asp-route-pagina="@p">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link"
                               asp-page="Index"
                               asp-route-solicitudId="@Model.SolicitudId"
                               asp-route-pagina="@(Model.PaginaActual + 1)">
                                Siguiente
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById('modalConfirmarEliminar');
            const form = document.getElementById('formConfirmarEliminar');

            if (modal && form) {
                modal.addEventListener('show.bs.modal', function (event) {
                    const boton = event.relatedTarget;

                    if (!boton) return;

                    const id = boton.getAttribute('data-id');

                    form.action = '?handler=Eliminar&id=' +
                        encodeURIComponent(id) +
                        '@(Model.SolicitudId.HasValue ? $"&solicitudId={Model.SolicitudId.Value}" : "")' +
                        '&pagina=@Model.PaginaActual';

                    const descripcion = boton.getAttribute('data-descripcion');
                    const texto = document.getElementById('eliminarRegistroDesc');
                    const campoId = document.getElementById('eliminarRegistroId');

                    if (texto && descripcion) texto.textContent = descripcion;
                    if (campoId) campoId.value = id;
                });
            }
        });
    </script>
}
