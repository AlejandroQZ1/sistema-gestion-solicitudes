@page
@model AdministracionSoluciones.Pages.Desgloses.IndexModel
@{
    ViewData["Title"] = "Desgloses de Solicitud";
}

<!-- ENCABEZADO DE PÁGINA (SOL2) -->
<div class="d-flex justify-content-between align-items-center flex-wrap mb-4 gap-3">
    <div>
        <h2 class="h3 mb-1 text-gray-800 font-weight-bold">
            <i class="bi bi-cash-stack text-primary me-2"></i>
            Administración de Desgloses
        </h2>
        <p class="text-muted mb-0">
            @if (Model.SolicitudSeleccionada != null)
            {
                <span>
                    Desgloses de la solicitud: 
                    <strong>@Model.SolicitudSeleccionada.ConsecutivoOficio</strong> — @Model.SolicitudSeleccionada.Titulo
                </span>
            }
            else
            {
                <span>Gestión del costo y horas planificadas mes a mes para las solicitudes.</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.SolicitudId.HasValue)
        {
            <a asp-page="/Solicitudes/Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver a Solicitudes
            </a>
            <a asp-page="Create" asp-route-solicitudId="@Model.SolicitudId" class="btn btn-primary" style="background-color: #243b6b; border-color: #243b6b;">
                <i class="bi bi-plus-circle me-1"></i> + Nuevo Desglose
            </a>
        }
        else
        {
            <a asp-page="Create" class="btn btn-primary" style="background-color: #243b6b; border-color: #243b6b;">
                <i class="bi bi-plus-circle me-1"></i> + Nuevo Desglose
            </a>
        }
    </div>
</div>

<!-- FILTRO RÁPIDO POR SOLICITUD -->
<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <label for="filtroSolicitud" class="col-form-label fw-bold text-secondary">
                    <i class="bi bi-funnel me-1"></i> Filtrar por solicitud:
                </label>
            </div>
            <div class="col-md-5 col-sm-8">
                <select name="solicitudId" id="filtroSolicitud" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Ver todas las solicitudes --</option>
                    @foreach (var sol in Model.SolicitudesDisponibles)
                    {
                        <!option value="@sol.SolicitudID" @(Model.SolicitudId == sol.SolicitudID ? "selected" : "")>
                            @sol.ConsecutivoOficio — @sol.Titulo
                        </!option>
                    }
                </select>
            </div>
            @if (Model.SolicitudId.HasValue)
            {
                <div class="col-auto">
                    <a asp-page="Index" class="btn btn-outline-secondary btn-sm">Limpiar filtro</a>
                </div>
            }
        </form>
    </div>
</div>

<!-- LISTADO DE DESGLOSES EN TARJETA -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="bi bi-table me-1"></i> Listado de Desgloses (@Model.TotalRegistros registros)
        </h6>
        <span class="badge bg-secondary">Página @Model.PaginaActual de @Model.TotalPaginas</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table tabla-siges align-middle mb-0">
                <thead>
                    <tr>
                        <th>Solicitud</th>
                        <th>Período</th>
                        <th class="text-end">Horas</th>
                        <th class="text-end">Monto Base</th>
                        <th class="text-end">IVA (13%)</th>
                        <th class="text-end">Total</th>
                        <th class="text-center">% Cobro</th>
                        <th class="text-center">Asignación</th>
                        <th>Observaciones</th>
                        <th class="text-center" style="min-width: 140px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Desgloses.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No se encontraron registros de desgloses.
                            </td>
                        </tr>
                    }
                    @foreach (var d in Model.Desgloses)
                    {
                        <tr>
                            <td>
                                <strong>@(d.ConsecutivoOficio ?? $"Solicitud #{d.SolicitudID}")</strong>
                                @if (!string.IsNullOrWhiteSpace(d.TituloSolicitud))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 200px;" title="@d.TituloSolicitud">
                                        @d.TituloSolicitud
                                    </div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @d.NombreMes @d.Anio
                                </span>
                            </td>
                            <td class="text-end fw-semibold">
                                @d.Horas.ToString("N1") h
                            </td>
                            <td class="text-end">
                                @d.Monto.ToString("C2")
                            </td>
                            <td class="text-end text-muted">
                                @d.IVA.ToString("C2")
                            </td>
                            <td class="text-end fw-bold text-success">
                                @d.Total.ToString("C2")
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">@d.PorcentajeCobro.ToString("N0")%</span>
                            </td>
                            <td class="text-center">
                                @if (d.Asignado)
                                {
                                    <span class="badge bg-warning text-dark" title="Tiene datos relacionados (protegido)">
                                        <i class="bi bi-lock-fill me-1"></i> Asignado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success" title="Sin asignar (se puede eliminar)">
                                        <i class="bi bi-unlock me-1"></i> Sin asignar
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="text-muted small text-truncate d-inline-block" style="max-width: 180px;" title="@d.Observaciones">
                                    @(string.IsNullOrWhiteSpace(d.Observaciones) ? "—" : d.Observaciones)
                                </span>
                            </td>
                            <td class="text-center text-nowrap">
                                <a asp-page="Edit" asp-route-id="@d.DesgloseID" class="btn btn-sm btn-outline-secondary me-1" title="Editar desglose">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>

                                <!-- Botón que invoca el diálogo modal de confirmación requerido (Pág. 16) -->
                                <button type="button" 
                                        class="btn btn-sm btn-outline-danger btn-confirmar-eliminar"
                                        data-bs-toggle="modal" 
                                        data-bs-target="#modalConfirmarEliminar"
                                        data-id="@d.DesgloseID"
                                        data-descripcion="Desglose de @d.NombreMes @d.Anio por @d.Total.ToString("C2") — @(d.Asignado ? "⚠️ ESTADO: ASIGNADO (Tiene datos relacionados)" : "Estado: Sin asignar")"
                                        title="Eliminar desglose">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- PAGINACIÓN (MÁXIMO 10 ELEMENTOS POR PÁGINA) -->
    @if (Model.TotalPaginas > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">
                Mostrando @Model.Desgloses.Count() de @Model.TotalRegistros registros
            </span>
            <nav aria-label="Navegación de páginas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-page="Index" asp-route-solicitudId="@Model.SolicitudId" asp-route-pagina="@(Model.PaginaActual - 1)">
                            Anterior
                        </a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPaginas; p++)
                    {
                        <li class="page-item @(p == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" asp-page="Index" asp-route-solicitudId="@Model.SolicitudId" asp-route-pagina="@p">
                                @p
                            </a>
                        </li>
                    }
                    <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-page="Index" asp-route-solicitudId="@Model.SolicitudId" asp-route-pagina="@(Model.PaginaActual + 1)">
                            Siguiente
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Configura el formulario del modal de eliminación para que envíe el handler OnPostEliminar
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById('modalConfirmarEliminar');
            const form = document.getElementById('formConfirmarEliminar');
            if (modal && form) {
                modal.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    const id = btn.getAttribute('data-id');
                    form.action = '?handler=Eliminar&id=' + encodeURIComponent(id) + 
                        '@(Model.SolicitudId.HasValue ? $"&solicitudId={Model.SolicitudId.Value}" : "")' +
                        '&pagina=@Model.PaginaActual';
                });
            }
        });
    </script>
}
