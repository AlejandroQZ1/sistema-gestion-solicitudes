
@page
@model AdministracionSoluciones.Pages.Desgloses.CreateModel

@{
    ViewData["Title"] = "Nuevo desglose";
}

<div class="container-fluid pagina-siges">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1 text-dark">Nuevo desglose</h1>
            <p class="text-muted mb-0">
                Registre las horas y los montos mensuales de la solicitud.
            </p>
        </div>

        <a asp-page="Index" asp-route-solicitudId="@Model.Desglose.SolicitudID"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al listado
        </a>
    </div>

    <div class="tarjeta-siges">
        <div class="tarjeta-siges-header">
            <h5><i class="bi bi-receipt me-2"></i>Información del desglose</h5>
        </div>

        <div class="tarjeta-siges-body">
            <form method="post" id="formDesglose">
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Desglose.SolicitudID" class="form-label">
                        Solicitud *
                    </label>
                    <select asp-for="Desglose.SolicitudID"
                            asp-items="Model.SolicitudesSelectList"
                            class="form-select" required>
                        <option value="">Seleccione una solicitud</option>
                    </select>
                    <span asp-validation-for="Desglose.SolicitudID"
                          class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Desglose.Mes" class="form-label">Mes *</label>
                        <select asp-for="Desglose.Mes"
                                asp-items="Model.MesesSelectList"
                                class="form-select" required></select>
                        <span asp-validation-for="Desglose.Mes"
                              class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Desglose.Anio" class="form-label">Año *</label>
                        <input asp-for="Desglose.Anio" type="number"
                               class="form-control" min="2000" max="2100" required />
                        <span asp-validation-for="Desglose.Anio"
                              class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Desglose.Horas" class="form-label">
                            Horas estimadas *
                        </label>
                        <div class="input-group">
                            <input asp-for="Desglose.Horas" type="number"
                                   step="0.5" min="0" class="form-control" required />
                            <span class="input-group-text">horas</span>
                        </div>
                        <span asp-validation-for="Desglose.Horas"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Desglose.PorcentajeCobro" class="form-label">
                            Porcentaje de cobro *
                        </label>
                        <div class="input-group">
                            <input asp-for="Desglose.PorcentajeCobro" type="number"
                                   step="1" min="0" max="100"
                                   class="form-control" required />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="Desglose.PorcentajeCobro"
                              class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4 p-3 bg-light rounded border">
                    <div class="col-md-4">
                        <label asp-for="Desglose.Monto" class="form-label">
                            Monto base *
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">₡</span>
                            <input asp-for="Desglose.Monto" type="number"
                                   step="0.01" min="0" class="form-control"
                                   id="desgloseMonto" required />
                        </div>
                        <span asp-validation-for="Desglose.Monto"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Desglose.IVA" class="form-label">IVA (13%)</label>
                        <div class="input-group">
                            <span class="input-group-text">₡</span>
                            <input asp-for="Desglose.IVA" type="text" readonly
                                   class="form-control bg-white" id="desgloseIVA" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Desglose.Total" class="form-label">Total</label>
                        <div class="input-group">
                            <span class="input-group-text">₡</span>
                            <input asp-for="Desglose.Total" type="text" readonly
                                   class="form-control bg-white fw-bold"
                                   id="desgloseTotal" />
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Desglose.Observaciones" class="form-label">
                        Observaciones
                    </label>
                    <textarea asp-for="Desglose.Observaciones" rows="3"
                              class="form-control"
                              placeholder="Detalle adicional del trabajo mensual..."></textarea>
                    <span asp-validation-for="Desglose.Observaciones"
                          class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-page="Index"
                       asp-route-solicitudId="@Model.Desglose.SolicitudID"
                       class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary" id="btnGuardarDesglose">
                        <i class="bi bi-check-lg me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("formDesglose");
            const boton = document.getElementById("btnGuardarDesglose");
            const inputMonto = document.getElementById("desgloseMonto");

            if (inputMonto) {
                inputMonto.dispatchEvent(new Event("input"));
            }

            form.addEventListener("submit", function (event) {
                if (!$(form).valid()) {
                    event.preventDefault();
                    return;
                }

                boton.disabled = true;
                boton.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';
            });
        });
    </script>
}
