
@page "{id:int?}"
@model AdministracionSoluciones.Pages.Representantes.FormModel

@{
    bool editando = RouteData.Values["id"] != null;
    ViewData["Title"] = editando ? "Editar representante" : "Nuevo representante";
}

<div class="container-fluid pagina-siges">
    <div class="mb-4">
        <h1 class="h3 mb-1 text-dark">
            @(editando ? "Editar representante" : "Nuevo representante")
        </h1>
        <p class="text-muted mb-0">Complete los datos del representante.</p>
    </div>

    <div class="tarjeta-siges">
        <div class="tarjeta-siges-header">
            <h5><i class="bi bi-person-vcard me-2"></i>Información del representante</h5>
        </div>

        <div class="tarjeta-siges-body">
            <form method="post">
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Nombre" class="form-label">Nombre</label>
                    <input asp-for="Input.Nombre" class="form-control" maxlength="150" />
                    <span asp-validation-for="Input.Nombre" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                    <input asp-for="Input.Email" type="email" class="form-control" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
