
@using AdministracionSoluciones.Seguridad
@{
    var paginaActual = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIGES</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AdministracionSoluciones.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="sistema">
        <aside class="sidebar" id="accordionSidebar">
            <a asp-page="/Index" class="logo-sistema">
                <div class="logo-icono">
                    <i class="bi bi-folder-check"></i>
                </div>
                <div class="logo-texto">
                    <h2>SIGES</h2>
                    <span>Adm. de Solicitudes</span>
                </div>
            </a>

            <div class="sidebar-divider"></div>

            <nav class="menu">
                <div class="sidebar-heading">Principal</div>

                <a asp-page="/Index"
                   class="menu-item @(paginaActual == "/Index" ? "active" : "")">
                    <span class="menu-icon"><i class="bi bi-house-door-fill"></i></span>
                    <span class="menu-text">Inicio</span>
                </a>

                <div class="sidebar-divider"></div>

                <div class="sidebar-heading">Administración</div>

                <a asp-page="/Usuarios/Index"
                   class="menu-item @(paginaActual.StartsWith("/Usuarios") ? "active" : "")">
                    <span class="menu-icon"><i class="bi bi-people-fill"></i></span>
                    <span class="menu-text">Usuarios</span>
                </a>

                <div class="sidebar-divider"></div>

                <a asp-page="/Representantes/Index"
                   class="menu-item @(paginaActual.StartsWith("/Representantes") ? "active" : "")">
                    <span class="menu-icon"><i class="bi bi-person-lines-fill"></i></span>
                    <span class="menu-text">Representantes</span>
                </a>

                <a asp-page="/EstadosSolicitudes/Index"
                   class="menu-item @(paginaActual.StartsWith("/EstadosSolicitudes") ? "active" : "")">
                    <span class="menu-icon"><i class="bi bi-list-check"></i></span>
                    <span class="menu-text">Estados de solicitudes</span>
                </a>

                <div class="sidebar-heading">Gestión</div>

                <a asp-page="/Solicitudes/Index"
                   class="menu-item @(paginaActual.StartsWith("/Solicitudes") ? "active" : "")">
                    <span class="menu-icon"><i class="bi bi-journal-text"></i></span>
                    <span class="menu-text">Solicitudes</span>
                </a>

                <div class="sidebar-divider"></div>

                <div class="sidebar-heading">Reportes</div>

                <a asp-page="/Reportes/MontosFacturacion"
                   class="menu-item @(paginaActual.StartsWith("/Reportes/MontosFacturacion") ? "active" : "")">
                    <span class="menu-icon"><i class="bi bi-graph-up-arrow"></i></span>
                    <span class="menu-text">Facturación Mensual</span>
                </a>

                <a asp-page="/ReportesTareas/PorUsuario"
                   class="menu-item @(paginaActual.StartsWith("/ReportesTareas/PorUsuario") ? "active" : "")">
                    <span class="menu-icon"><i class="bi bi-person-check"></i></span>
                    <span class="menu-text">Tareas por usuario</span>
                </a>

                <a asp-page="/ReportesTareas/PorSolicitud"
                   class="menu-item @(paginaActual.StartsWith("/ReportesTareas/PorSolicitud") ? "active" : "")">
                    <span class="menu-icon"><i class="bi bi-clipboard-check"></i></span>
                    <span class="menu-text">Tareas por solicitud</span>
                </a>
            </nav>

            <div class="sidebar-toggler-wrapper">
                <button type="button" class="sidebar-toggler-btn"
                        id="sidebarToggle" title="Plegar / desplegar menú">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>

            <div class="cerrar-sesion p-2">
                <a asp-page="/Login/CerrarSesion" class="menu-item text-danger">
                    <span class="menu-icon"><i class="bi bi-box-arrow-right"></i></span>
                    <span class="menu-text">Cerrar sesión</span>
                </a>
            </div>
        </aside>

        <div class="contenido-sistema">
            <header class="topbar">
                <div class="topbar-left">
                    <button type="button" class="btn-sidebar-toggle-top"
                            id="sidebarToggleTop" title="Menú">
                        <i class="bi bi-list"></i>
                    </button>
                    <h1 class="topbar-title">@ViewData["Title"]</h1>
                </div>

                <div class="topbar-user">
                    <div class="dropdown">
                        <a href="#" class="usuario-dropdown-btn dropdown-toggle"
                           id="userMenuDropdown" data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <div class="datos-usuario">
                                <strong>@Sesion.NombreCompleto(Context)</strong>
                                <span>@@@Sesion.NombreUsuario(Context)</span>
                            </div>
                            <div class="avatar" title="@Sesion.NombreCompleto(Context)">
                                @{
                                    var nombreCompleto = Sesion.NombreCompleto(Context);
                                    var inicial = !string.IsNullOrEmpty(nombreCompleto)
                                        ? nombreCompleto.Substring(0, 1).ToUpper()
                                        : "U";
                                }
                                <span>@inicial</span>
                            </div>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow border-0"
                            aria-labelledby="userMenuDropdown">
                            <li class="px-3 py-2 text-muted small border-bottom">
                                Conectado como:
                                <strong>@Sesion.NombreUsuario(Context)</strong>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-page="/Index">
                                    <i class="bi bi-house-door me-2 text-primary"></i> Inicio
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-page="/Usuarios/Index">
                                    <i class="bi bi-person me-2 text-secondary"></i>
                                    Administrar Usuarios
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2 text-danger"
                                   asp-page="/Login/CerrarSesion">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Cerrar sesión
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="contenido-principal">
                @if (paginaActual.StartsWith("/Desgloses"))
                {
                    <partial name="_ResultadoDesglose" />
                }
                else
                {
                    @if (TempData["Exito"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm"
                             role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["Exito"]
                            <button type="button" class="btn-close"
                                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
                             role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["Error"]
                            <button type="button" class="btn-close"
                                    data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }

                }

                @RenderBody()
            </main>

            <footer class="footer-sistema no-print">
                <span>&copy; @DateTime.Now.Year <strong>SIGES</strong> -
                    Sistema de Administración de Solicitudes</span>
                <span class="text-muted">Colegio Universitario de Cartago</span>
            </footer>
        </div>
    </div>

    @if (paginaActual.StartsWith("/Desgloses"))
    {
        <div class="modal fade" id="modalConfirmarEliminar"
             tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content shadow border-0">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="modalEliminarLabel">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Confirmar eliminación
                        </h5>
                        <button type="button" class="btn-close btn-close-white"
                                data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body py-4">
                        <p class="fs-5 mb-2">
                            ¿Realmente desea eliminar el elemento seleccionado?
                        </p>
                        <div class="alert alert-warning py-2 mb-0 small"
                             id="eliminarRegistroDesc">
                            Esta acción es permanente y no se puede deshacer.
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary px-4"
                                data-bs-dismiss="modal">No</button>
                        <form id="formConfirmarEliminar" method="post" class="d-inline">
                            <input type="hidden" name="id" id="eliminarRegistroId" />
                            <button type="submit" class="btn btn-danger px-4">Sí</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
