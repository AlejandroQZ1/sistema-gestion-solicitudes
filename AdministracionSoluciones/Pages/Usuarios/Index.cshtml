
@page
@model AdministracionSoluciones.Pages.Usuarios.IndexModel

@{
    ViewData["Title"] = "Usuarios";
    var idActual = Model.UsuarioSesionID;
}

<link rel="stylesheet" href="~/css/seguridad.css" asp-append-version="true" />

<div class="container-fluid pagina-siges">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 mb-1 fw-bold text-dark">
                <i class="bi bi-people-fill text-primary me-2"></i>
                Administración de usuarios
            </h2>
            <p class="text-muted mb-0">
                Consulta y administra los usuarios registrados en SIGES.
            </p>
        </div>

        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-1"></i>
            Nuevo usuario
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <section class="tarjeta-siges">
        <div class="tarjeta-siges-header">
            <h5>
                <i class="bi bi-list-ul me-2"></i>
                Usuarios registrados
            </h5>

            <span class="badge bg-primary text-white">
                Total: @Model.Usuarios.Count()
            </span>
        </div>

        <div class="tarjeta-siges-body p-0">
            <div class="table-responsive">
                <table class="table tabla-siges table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Nombre completo</th>
                            <th>Correo electrónico</th>
                            <th>Estado</th>
                            <th>Cambiar estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Usuarios.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-people fs-2 d-block mb-2"></i>
                                    No hay usuarios registrados.
                                </td>
                            </tr>
                        }

                        @foreach (var u in Model.Usuarios)
                        {
                            var esActual = u.UsuarioID == idActual;
                            var estadoActual = (u.Estado ?? "").ToLowerInvariant();

                            var claseEstado = estadoActual switch
                            {
                                "activo" => "bg-success text-white",
                                "inactivo" => "bg-secondary text-white",
                                "bloqueado" => "bg-danger text-white",
                                _ => "bg-secondary text-white"
                            };

                            <tr>
                                <td class="text-nowrap">
                                    <span class="fw-semibold">@u.NombreUsuario</span>

                                    @if (esActual)
                                    {
                                        <span class="badge bg-light text-dark border ms-1">Usted</span>
                                    }
                                </td>

                                <td>@u.NombreCompleto</td>

                                <td>@u.Correo</td>

                                <td>
                                    <span class="badge rounded-pill @claseEstado">
                                        @u.Estado
                                    </span>
                                </td>

                                <td>
                                    @if (esActual)
                                    {
                                        <span class="text-muted small">
                                            Usuario de la sesión actual
                                        </span>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var estado in EstadosUsuario.Todos.Where(e => e != u.Estado))
                                            {
                                                var texto = estado == EstadosUsuario.Activo ? "Activar"
                                                          : estado == EstadosUsuario.Inactivo ? "Inactivar"
                                                          : "Bloquear";

                                                var claseBoton = estado == EstadosUsuario.Activo ? "btn-outline-success"
                                                               : estado == EstadosUsuario.Inactivo ? "btn-outline-secondary"
                                                               : "btn-outline-danger";

                                                <form asp-page-handler="CambiarEstado" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@u.UsuarioID" />
                                                    <input type="hidden" name="estado" value="@estado" />

                                                    <button type="submit"
                                                            class="btn btn-sm @claseBoton"
                                                            onclick="return confirm('¿Deseas cambiar el estado de este usuario?');">
                                                        @texto
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex justify-content-end flex-wrap gap-2">
                                        <a asp-page="Edit"
                                           asp-route-id="@u.UsuarioID"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square me-1"></i>
                                            Editar
                                        </a>

                                        @if (!esActual)
                                        {
                                            <a asp-page="Delete"
                                               asp-route-id="@u.UsuarioID"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash me-1"></i>
                                                Eliminar
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<style>
    .pagina-siges .table td {
        vertical-align: middle;
    }

    .pagina-siges .table th {
        white-space: nowrap;
    }

    .pagina-siges .table td {
        min-width: 100px;
    }

    .pagina-siges .table td:nth-child(5) {
        min-width: 190px;
    }

    .pagina-siges .table td:nth-child(6) {
        min-width: 180px;
    }

    .pagina-siges .table form {
        margin: 0;
    }
</style>
