@page
@model AdministracionSoluciones.Pages.Usuarios.IndexModel
@{
    // USR4 - Listado de usuarios
    ViewData["Title"] = "Usuarios";
    var idActual = Model.UsuarioSesionID;
}
<link rel="stylesheet" href="~/css/seguridad.css" asp-append-version="true" />

<div class="seg-encabezado">
    <div>
        <h2>Administración de usuarios</h2>
        <p>@Model.Usuarios.Count() usuario(s) registrado(s)</p>
    </div>
    <a asp-page="Create" class="btn seg-btn-primario">+ Nuevo usuario</a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["Exito"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="seg-tarjeta">
    <div class="table-responsive">
        <table class="table seg-tabla align-middle mb-0">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Nombre completo</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th>Cambiar estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Usuarios.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No hay usuarios registrados.</td>
                    </tr>
                }
                @foreach (var u in Model.Usuarios)
                {
                    var esActual = u.UsuarioID == idActual;
                    <tr>
                        <td><strong>@u.NombreUsuario</strong>@if (esActual) {<span class="seg-tu"> (usted)</span>}</td>
                        <td>@u.NombreCompleto</td>
                        <td>@u.Correo</td>
                        <td><span class="seg-estado seg-estado-@u.Estado.ToLower()">@u.Estado</span></td>
                        <td>
                            @if (esActual)
                            {
                                <span class="text-muted small">—</span>
                            }
                            else
                            {
                                <div class="seg-estados">
                                    @foreach (var estado in EstadosUsuario.Todos.Where(e => e != u.Estado))
                                    {
                                        var texto = estado == EstadosUsuario.Activo ? "Activar"
                                                  : estado == EstadosUsuario.Inactivo ? "Inactivar"
                                                  : "Bloquear";
                                        <form asp-page-handler="CambiarEstado" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@u.UsuarioID" />
                                            <input type="hidden" name="estado" value="@estado" />
                                            <button type="submit" class="btn btn-sm seg-btn-estado seg-btn-@estado.ToLower()">@texto</button>
                                        </form>
                                    }
                                </div>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a asp-page="Edit" asp-route-id="@u.UsuarioID" class="btn btn-sm btn-outline-secondary">Editar</a>
                            @if (!esActual)
                            {
                                <a asp-page="Delete" asp-route-id="@u.UsuarioID" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
