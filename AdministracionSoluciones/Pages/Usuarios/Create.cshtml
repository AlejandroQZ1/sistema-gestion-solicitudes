
@page
@model AdministracionSoluciones.Pages.Usuarios.CreateModel

@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="container-fluid pagina-siges">
    <div class="mb-4">
        <h1 class="h3 mb-1 text-dark">Nuevo usuario</h1>
        <p class="text-muted mb-0">Complete la información para registrar un usuario.</p>
    </div>

    <div class="tarjeta-siges">
        <div class="tarjeta-siges-header">
            <h5><i class="bi bi-person-plus me-2"></i>Información del usuario</h5>
        </div>

        <div class="tarjeta-siges-body">
            <form method="post" autocomplete="off" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <partial name="_Formulario" for="Input" />

                <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
