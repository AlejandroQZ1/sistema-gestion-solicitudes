
@page
@model AdministracionSoluciones.Pages.Reportes.MontosFacturacionModel

@{
    ViewData["Title"] = "Reporte de facturación mensual";
}

<div class="container-fluid pagina-siges">
    <div class="mb-4">
        <h2 class="h3 mb-1">Reporte de facturación mensual</h2>
        <p class="text-muted mb-0">
            Consulta los montos que se facturarán por solicitud, mes y año.
        </p>
    </div>

    <div class="tarjeta-siges mb-4">
        <div class="p-3">
            <h3 class="h5 mb-3">Filtros del reporte</h3>

            <form method="get" class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label for="selectMes" class="form-label">Mes</label>
                    <select name="Mes"
                            id="selectMes"
                            asp-items="Model.MesesSelectList"
                            class="form-select">
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label for="inputAnio" class="form-label">Año</label>
                    <input type="number"
                           name="Anio"
                           id="inputAnio"
                           value="@Model.Anio"
                           min="2000"
                           max="2100"
                           class="form-control"
                           required />
                </div>

                <div class="col-12 col-md-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>
                        Consultar reporte
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="tarjeta-siges">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 p-3">
            <div>
                <h3 class="h5 mb-1">Detalle de facturación</h3>
                <p class="text-muted mb-0">
                    Período: @Model.Reporte.NombreMes @Model.Reporte.Anio
                </p>
            </div>

            <span class="badge text-bg-secondary">
                @Model.Reporte.Items.Count() solicitud(es)
            </span>
        </div>

        <div class="table-responsive">
            <table class="table tabla-siges align-middle mb-0">
                <thead>
                    <tr>
                        <th>Consecutivo</th>
                        <th>Título de la solicitud</th>
                        <th class="text-center">Mes</th>
                        <th class="text-center">Año</th>
                        <th class="text-end">Monto</th>
                        <th class="text-end">IVA (13%)</th>
                        <th class="text-end">Total por solicitud</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Reporte.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No hay montos registrados para
                                <strong>@Model.Reporte.NombreMes @Model.Reporte.Anio</strong>.
                                <div class="small mt-1">
                                    Prueba con otro mes o año.
                                </div>
                            </td>
                        </tr>
                    }

                    @foreach (var item in Model.Reporte.Items)
                    {
                        <tr>
                            <td class="text-nowrap">
                                <strong>@item.ConsecutivoOficio</strong>
                            </td>

                            <td>@item.Titulo</td>

                            <td class="text-center">@item.NombreMes</td>

                            <td class="text-center">@item.Anio</td>

                            <td class="text-end text-nowrap">
                                @item.Monto.ToString("C2")
                            </td>

                            <td class="text-end text-nowrap">
                                @item.IVA.ToString("C2")
                            </td>

                            <td class="text-end fw-semibold text-nowrap">
                                @item.Total.ToString("C2")
                            </td>
                        </tr>
                    }
                </tbody>

                @if (Model.Reporte.Items.Any())
                {
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end fw-bold">
                                Totales del período
                            </td>

                            <td class="text-end fw-bold text-nowrap">
                                @Model.Reporte.TotalMonto.ToString("C2")
                            </td>

                            <td class="text-end fw-bold text-nowrap">
                                @Model.Reporte.TotalIVA.ToString("C2")
                            </td>

                            <td class="text-end fw-bold text-nowrap">
                                @Model.Reporte.TotalGeneral.ToString("C2")
                            </td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>
