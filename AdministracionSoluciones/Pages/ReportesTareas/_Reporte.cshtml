@* Filtros y resultados de los reportes mensuales por usuario o por solicitud. *@
@model AdministracionSoluciones.Models.Tareas.ReporteTareas
@using System.Globalization
@{
    ViewData["Title"] = Model.PorUsuario ? "Tareas de un usuario por mes" : "Tareas de una solicitud por mes";
    var meses = CultureInfo.GetCultureInfo("es-CR").DateTimeFormat.MonthNames;
    var accion = Model.PorUsuario ? "PorUsuario" : "PorSolicitud";
}
<link rel="stylesheet" href="~/css/tareas.css" asp-append-version="true" />
<div class="tareas-modulo">
    <partial name="_ValidacionTareas" />
    <nav aria-label="Tipo de reporte" class="nav nav-pills mb-4">
        <a asp-page="PorUsuario" class="nav-link @(Model.PorUsuario ? "active" : "")">Por usuario</a>
        <a asp-page="PorSolicitud" class="nav-link @(!Model.PorUsuario ? "active" : "")">Por solicitud</a>
    </nav>
    <form method="get" asp-page="@accion" class="mb-4" novalidate>
        <input type="hidden" name="Consultar" value="true" />
        <div class="tareas-filtros">
            <div class="flex-grow-1">
                <label for="SeleccionId" class="form-label">@(Model.PorUsuario ? "Usuario" : "Solicitud")</label>
                <select name="SeleccionId" id="SeleccionId" class="form-select" required>
                    <option value="">Seleccione @(Model.PorUsuario ? "un usuario" : "una solicitud")</option>
                    @if (Model.PorUsuario)
                    {
                        foreach (var usuario in Model.Usuarios)
                        {
                            <option value="@usuario.Id" selected="@(usuario.Id == Model.Filtro.SeleccionId)">@usuario.Etiqueta</option>
                        }
                    }
                    else
                    {
                        foreach (var solicitud in Model.Solicitudes)
                        {
                            <option value="@solicitud.Id" selected="@(solicitud.Id == Model.Filtro.SeleccionId)">@solicitud.Etiqueta</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label for="Mes" class="form-label">Mes</label>
                <select name="Mes" id="Mes" class="form-select" required>
                    <option value="">Seleccione un mes</option>
                    @for (int mes = 1; mes <= 12; mes++)
                    {
                        <option value="@mes" selected="@(mes == Model.Filtro.Mes)">@meses[mes - 1]</option>
                    }
                </select>
            </div>
            <div>
                <label for="Anio" class="form-label">Año</label>
                <input name="Anio" id="Anio" type="number" min="1000" max="9999" value="@Model.Filtro.Anio" class="form-control" required />
            </div>
            <button class="btn btn-primary" type="submit">Generar reporte</button>
        </div>
    </form>
    @* Los resultados aparecen únicamente después de validar los filtros. *@
    @if (Model.Filas is not null)
    {
        <h2 class="h5">@Model.Seleccion</h2>
        <p class="text-muted">@meses[Model.Filtro.Mes!.Value - 1] de @Model.Filtro.Anio</p>
        <div class="table-responsive tareas-tabla">
            <table class="table align-middle mb-0" id="reporte-tareas">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Fecha</th>
                        <th>Descripción de la tarea</th>
                        <th class="text-end">Horas invertidas</th>
                        <th>Consecutivo del oficio</th>
                        <th>Título de la solicitud</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Filas)
                    {
                        <tr>
                            <td>@fila.NombreCompleto <span class="text-muted">(@fila.NombreUsuario)</span></td>
                            <td class="text-nowrap">@fila.Fecha?.ToString("dd/MM/yyyy")</td>
                            <td class="tarea-descripcion">@fila.Descripcion</td>
                            <td class="text-end">@(fila.Horas?.ToString("0.##") ?? "—")</td>
                            <td>@fila.Consecutivo</td>
                            <td>@fila.Titulo</td>
                        </tr>
                    }
                    @if (Model.Filas.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No hay tareas para los filtros seleccionados.</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="3">Total de horas</th>
                        <td class="text-end fw-bold" id="total-horas">@Model.TotalHoras.ToString("0.##")</td>
                        <td colspan="2"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>
