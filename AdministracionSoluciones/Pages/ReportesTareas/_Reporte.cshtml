
@* Filtros y resultados de los reportes mensuales por usuario o solicitud. *@
@model AdministracionSoluciones.Entities.Tareas.ReporteTareas
@using System.Globalization

@{
    ViewData["Title"] = Model.PorUsuario
        ? "Tareas por usuario"
        : "Tareas por solicitud";

    var meses = CultureInfo.GetCultureInfo("es-CR").DateTimeFormat.MonthNames;
    var accion = Model.PorUsuario ? "PorUsuario" : "PorSolicitud";
}

<div class="container-fluid pagina-siges">
    <div class="mb-4">
        <h2 class="h3 mb-1">
            @(Model.PorUsuario
                ? "Reporte de tareas por usuario"
                : "Reporte de tareas por solicitud")
        </h2>

        <p class="text-muted mb-0">
            Consulta las tareas registradas durante un mes y revisa el total de horas.
        </p>
    </div>

    <partial name="_ValidacionTareas" />

    <div class="tarjeta-siges mb-4">
        <div class="p-3">
            <h3 class="h5 mb-3">Filtros del reporte</h3>

            <form method="get" asp-page="@accion">
                <input type="hidden" name="Consultar" value="true" />

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-lg-5">
                        <label for="SeleccionId" class="form-label">
                            @(Model.PorUsuario ? "Usuario" : "Solicitud")
                        </label>

                        <select name="SeleccionId"
                                id="SeleccionId"
                                class="form-select"
                                required>
                            <option value="">
                                Seleccione @(Model.PorUsuario
                                    ? "un usuario"
                                    : "una solicitud")
                            </option>

                            @if (Model.PorUsuario)
                            {
                                foreach (var usuario in Model.Usuarios)
                                {
                                    <option value="@usuario.Id"
                                            selected="@(usuario.Id == Model.Filtro.SeleccionId)">
                                        @usuario.Etiqueta
                                    </option>
                                }
                            }
                            else
                            {
                                foreach (var solicitud in Model.Solicitudes)
                                {
                                    <option value="@solicitud.Id"
                                            selected="@(solicitud.Id == Model.Filtro.SeleccionId)">
                                        @solicitud.Etiqueta
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-5 col-lg-3">
                        <label for="Mes" class="form-label">Mes</label>

                        <select name="Mes" id="Mes" class="form-select" required>
                            <option value="">Seleccione un mes</option>

                            @for (int mes = 1; mes <= 12; mes++)
                            {
                                <option value="@mes"
                                        selected="@(mes == Model.Filtro.Mes)">
                                    @meses[mes - 1]
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-12 col-md-5 col-lg-2">
                        <label for="Anio" class="form-label">Año</label>

                        <input name="Anio"
                               id="Anio"
                               type="number"
                               min="1000"
                               max="9999"
                               value="@Model.Filtro.Anio"
                               class="form-control"
                               required />
                    </div>

                    <div class="col-12 col-md-7 col-lg-2">
                        <button class="btn btn-primary w-100" type="submit">
                            <i class="bi bi-search me-1"></i>
                            Consultar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* Los resultados aparecen después de consultar y validar los filtros. *@
    @if (Model.Filas is not null)
    {
        <div class="tarjeta-siges">
            <div class="p-3">
                <h3 class="h5 mb-1">@Model.Seleccion</h3>

                <p class="text-muted mb-0">
                    Período: @meses[Model.Filtro.Mes!.Value - 1]
                    de @Model.Filtro.Anio
                </p>
            </div>

            <div class="table-responsive">
                <table class="table tabla-siges align-middle mb-0"
                       id="reporte-tareas">
                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Fecha</th>
                            <th>Descripción de la tarea</th>
                            <th class="text-end">Horas invertidas</th>
                            <th>Consecutivo del oficio</th>
                            <th>Título de la solicitud</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var fila in Model.Filas)
                        {
                            <tr>
                                <td>
                                    @fila.NombreCompleto
                                    <div class="text-muted small">
                                        @fila.NombreUsuario
                                    </div>
                                </td>

                                <td class="text-nowrap">
                                    @fila.Fecha?.ToString("dd/MM/yyyy")
                                </td>

                                <td>@fila.Descripcion</td>

                                <td class="text-end text-nowrap">
                                    @(fila.Horas?.ToString("0.##") ?? "—")
                                </td>

                                <td>@fila.Consecutivo</td>

                                <td>@fila.Titulo</td>
                            </tr>
                        }

                        @if (Model.Filas.Count == 0)
                        {
                            <tr>
                                <td colspan="6"
                                    class="text-center text-muted py-4">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    No hay tareas para los filtros seleccionados.
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end">
                                <strong>Total de horas</strong>
                            </td>

                            <td class="text-end" id="total-horas">
                                <strong>@Model.TotalHoras.ToString("0.##")</strong>
                            </td>

                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</div>
