@* Diálogo de confirmación identificado por tarea; la opción No solo cierra el diálogo. *@
@model AdministracionSoluciones.Entities.TareaFila
<div class="modal fade" id="confirmarEliminar-@Model.Id" tabindex="-1" aria-labelledby="tituloEliminar-@Model.Id" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="tituloEliminar-@Model.Id">Confirmar eliminación</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>¿Realmente desea eliminar el elemento seleccionado?</p>
                <p class="tarea-descripcion text-muted mb-0">@Model.Descripcion</p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page="Index" asp-page-handler="Eliminar" asp-route-id="@Model.Id" asp-route-solicitudId="@Model.SolicitudId">
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
            </div>
        </div>
    </div>
</div>
