@* Formulario compartido para crear y editar los campos de una tarea. *@
@model AdministracionSoluciones.Pages.Tareas.FormularioTareaModel
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = Model.Input.TareaId.HasValue ? "Editar tarea" : "Nueva tarea";
}
<link rel="stylesheet" href="~/css/tareas.css" asp-append-version="true" />
<div class="tareas-modulo">
    <partial name="_ValidacionTareas" />
    @if (!Model.ElegirSolicitud)
    {
        <p class="mb-4"><strong>Solicitud:</strong> @Model.Input.Solicitud.Etiqueta</p>
    }
    @* Los Tag Helpers generan las rutas y el token antifalsificación del formulario. *@
    <form method="post" asp-page="@(Model.Input.TareaId.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Input.TareaId" asp-route-solicitudId="@(Model.ElegirSolicitud ? (int?)null : Model.Input.Solicitud.Id)" asp-route-todas="@Model.Todas" class="tareas-formulario" novalidate>
        @if (Model.ElegirSolicitud)
        {
            <div class="mb-3">
                <label asp-for="SolicitudSeleccionada" class="form-label">Solicitud</label>
                <select asp-for="SolicitudSeleccionada" asp-items="@(new SelectList(Model.Solicitudes, "Id", "Etiqueta"))" class="form-select" required>
                    <option value="">Seleccione una solicitud</option>
                </select>
                @if (Model.Solicitudes.Count == 0)
                {
                    <p class="text-muted mt-2">No hay solicitudes disponibles. Primero registre una solicitud.</p>
                }
            </div>
        }
        <div class="mb-3">
            <label asp-for="Input.Descripcion" class="form-label"></label>
            <textarea asp-for="Input.Descripcion" class="form-control" rows="4"></textarea>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Input.Fecha" class="form-label"></label>
                <input asp-for="Input.Fecha" class="form-control" type="date" min="1000-01-01" max="9999-12-31" />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.Horas" class="form-label"></label>
                <input asp-for="Input.Horas" value="@(Model.Input.Horas?.ToString("0.##", CultureInfo.InvariantCulture))" type="number" step="0.01" min="-99999999.99" max="99999999.99" class="form-control" />
            </div>
        </div>
        <div class="mb-4">
            <label asp-for="Input.UsuarioId" class="form-label"></label>
            <select asp-for="Input.UsuarioId" asp-items="@(new SelectList(Model.Input.Usuarios, "Id", "Etiqueta"))" class="form-select" required>
                <option value="">Seleccione un usuario</option>
            </select>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-page="Index" asp-route-solicitudId="@(Model.Todas ? (int?)null : Model.Input.Solicitud.Id)" class="btn btn-outline-secondary">Regresar al listado</a>
        </div>
    </form>
</div>
