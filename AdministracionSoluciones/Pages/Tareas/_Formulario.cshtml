
@* Formulario compartido para crear y editar tareas. *@
@model AdministracionSoluciones.Pages.Tareas.FormularioTareaModel
@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = Model.Input.TareaId.HasValue ? "Editar tarea" : "Nueva tarea";
}

<div class="container-fluid pagina-siges">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1 text-dark">
                @(Model.Input.TareaId.HasValue ? "Editar tarea" : "Nueva tarea")
            </h1>
            <p class="text-muted mb-0">Complete los datos de la tarea.</p>
        </div>
        <a asp-page="Index"
           asp-route-solicitudId="@(Model.Todas ? (int?)null : Model.Input.Solicitud.Id)"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al listado
        </a>
    </div>

    <div class="tarjeta-siges">
        <div class="tarjeta-siges-header">
            <h5><i class="bi bi-list-task me-2"></i>Información de la tarea</h5>
        </div>

        <div class="tarjeta-siges-body">
            <partial name="_ValidacionTareas" />

            @if (!Model.ElegirSolicitud)
            {
                <div class="alert alert-light border mb-4">
                    <strong>Solicitud:</strong> @Model.Input.Solicitud.Etiqueta
                </div>
            }

            <form method="post"
                  asp-page="@(Model.Input.TareaId.HasValue ? "Edit" : "Create")"
                  asp-route-id="@Model.Input.TareaId"
                  asp-route-solicitudId="@(Model.ElegirSolicitud ? (int?)null : Model.Input.Solicitud.Id)"
                  asp-route-todas="@Model.Todas"
                  class="tareas-formulario">

                @if (Model.Input.TareaId.HasValue)
                {
                    <input type="hidden" asp-for="Input.TareaId" />
                }

                @if (Model.ElegirSolicitud)
                {
                    <div class="mb-3">
                        <label asp-for="SolicitudSeleccionada" class="form-label">Solicitud</label>
                        <select asp-for="SolicitudSeleccionada"
                                asp-items="@(new SelectList(Model.Solicitudes, "Id", "Etiqueta"))"
                                class="form-select" required>
                            <option value="">Seleccione una solicitud</option>
                        </select>
                        <span asp-validation-for="SolicitudSeleccionada" class="text-danger small"></span>

                        @if (Model.Solicitudes.Count == 0)
                        {
                            <p class="text-muted mt-2">No hay solicitudes disponibles. Primero registre una solicitud.</p>
                        }
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Input.Descripcion" class="form-label"></label>
                    <textarea asp-for="Input.Descripcion" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Input.Descripcion" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Input.Fecha" class="form-label"></label>
                        <input asp-for="Input.Fecha" class="form-control" type="date"
                               min="1000-01-01" max="9999-12-31" />
                        <span asp-validation-for="Input.Fecha" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Horas" class="form-label"></label>
                        <input asp-for="Input.Horas"
                               value="@(Model.Input.Horas?.ToString("0.##", CultureInfo.InvariantCulture))"
                               type="number" step="0.01"
                               min="-99999999.99" max="99999999.99"
                               class="form-control" />
                        <span asp-validation-for="Input.Horas" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.UsuarioId" class="form-label"></label>
                    <select asp-for="Input.UsuarioId"
                            asp-items="@(new SelectList(Model.Input.Usuarios, "Id", "Etiqueta"))"
                            class="form-select" required>
                        <option value="">Seleccione un usuario</option>
                    </select>
                    <span asp-validation-for="Input.UsuarioId" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-page="Index"
                       asp-route-solicitudId="@(Model.Todas ? (int?)null : Model.Input.Solicitud.Id)"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
