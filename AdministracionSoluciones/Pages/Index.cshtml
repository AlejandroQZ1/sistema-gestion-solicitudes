
@page
@model AdministracionSoluciones.Pages.IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="container-fluid pagina-siges">
    <div class="mb-4">
        <h2 class="h3 mb-1">Bienvenido a SIGES</h2>
        <p class="text-muted mb-0">Sistema de Administración de Solicitudes</p>
    </div>

    <div class="tarjeta-siges">
        <div class="p-5 text-center">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-4"
                 style="width: 88px; height: 88px; background-color: #e8efff; color: #315da8;">
                <i class="bi bi-folder-check" style="font-size: 2.8rem;"></i>
            </div>

            <h3 class="h4 mb-2">Bienvenido, @Model.NombreCompleto</h3>
        </div>
    </div>
</div>
