@page
@model AdministracionSoluciones.Pages.Solicitudes.IndexModel

@{
    ViewData["Title"] = "Administración de solicitudes";
}

<div class="container-fluid pagina-siges">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="h3 mb-1 fw-bold text-dark">
                <i class="bi bi-journal-text text-primary me-2"></i>
                Administración de solicitudes
            </h2>
            <p class="text-muted mb-0">
                Consulta y administra las solicitudes registradas en el sistema.
            </p>
        </div>

        <a asp-page="/Solicitudes/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Nueva solicitud
        </a>
    </div>

    @if (TempData["Exito"] is string mensajeExito)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @mensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] is string mensajeError)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @mensajeError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <section class="tarjeta-siges">
        <div class="tarjeta-siges-header">
            <h5>
                <i class="bi bi-list-ul me-2"></i>
                Solicitudes registradas
            </h5>
            <span class="badge bg-primary text-white">
                Total: @Model.Total
            </span>
        </div>

        <div class="tarjeta-siges-body">

            @if (!Model.Solicitudes.Any())
            {
                <div class="alert alert-light border text-center py-4 mb-0">
                    <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                    <span class="fw-semibold">No hay solicitudes registradas.</span>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table tabla-siges table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Consecutivo</th>
                                <th>Título</th>
                                <th>Representante</th>
                                <th>Estado</th>
                                <th>Ingreso</th>
                                <th>Respuesta</th>
                                <th>Inicio</th>
                                <th>Publicación externa</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var solicitud in Model.Solicitudes)
                            {
                                var identificador = solicitud.IdentificadorEstado?.ToUpperInvariant() ?? "";
                                var publicacionVencida = solicitud.Publicado
                                    && solicitud.FechaVencimientoPublicacion.HasValue
                                    && solicitud.FechaVencimientoPublicacion.Value.Date < DateTime.Today;

                                var claseEstado = solicitud.VenceHoy
                                    ? "bg-warning text-dark"
                                    : identificador switch
                                    {
                                        "NUEVA" => "bg-success text-white",
                                        "VENCIDA" => "bg-danger text-white",
                                        _ => "bg-secondary text-white"
                                    };

                                <tr>
                                    <td class="text-nowrap">
                                        <span class="fw-bold">@solicitud.ConsecutivoOficio</span>
                                    </td>

                                    <td class="solicitud-titulo">
                                        <div class="fw-semibold">@solicitud.Titulo</div>

                                        @if (!string.IsNullOrWhiteSpace(solicitud.Descripcion))
                                        {
                                            <div class="text-muted small mt-1">
                                                @(solicitud.Descripcion.Length > 90
                                                    ? solicitud.Descripcion[..90] + "..."
                                                    : solicitud.Descripcion)
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        @(solicitud.NombreRepresentante ?? "Sin asignar")
                                    </td>

                                    <td class="text-nowrap">
                                        <span class="badge rounded-pill @claseEstado">
                                            @(solicitud.VenceHoy
                                                ? "Vence hoy"
                                                : solicitud.NombreEstado ?? "Sin estado")
                                        </span>
                                    </td>

                                    <td class="text-nowrap">
                                        @solicitud.FechaIngreso.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-nowrap">
                                        @(solicitud.FechaRespuesta?.ToString("dd/MM/yyyy") ?? "—")
                                    </td>

                                    <td class="text-nowrap">
                                        @(solicitud.FechaInicio?.ToString("dd/MM/yyyy") ?? "—")
                                    </td>

                                    <td class="text-nowrap">
                                        @if (!solicitud.Publicado)
                                        {
                                            <span class="badge bg-secondary">No publicada</span>
                                        }
                                        else if (!solicitud.FechaVencimientoPublicacion.HasValue)
                                        {
                                            <span class="badge bg-warning text-dark">Sin vencimiento</span>
                                        }
                                        else if (publicacionVencida)
                                        {
                                            <span class="badge bg-danger">Vencida</span>
                                            <div class="small text-muted mt-1">@solicitud.FechaVencimientoPublicacion.Value.ToString("dd/MM/yyyy")</div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Publicada</span>
                                            <div class="small text-muted mt-1">Hasta @solicitud.FechaVencimientoPublicacion.Value.ToString("dd/MM/yyyy")</div>
                                        }
                                    </td>

                                    <td>
                                        <div class="acciones-solicitud">
                                            <form method="post"
                                                  asp-page-handler="ActualizarPublicacion"
                                                  asp-antiforgery="true"
                                                  class="publicacion-solicitud">
                                                <input type="hidden" name="id" value="@solicitud.SolicitudID" />
                                                <input type="hidden" name="pagina" value="@Model.Pagina" />
                                                <label class="small fw-semibold" for="fecha-publicacion-@solicitud.SolicitudID">
                                                    Vencimiento de publicación
                                                </label>
                                                <input id="fecha-publicacion-@solicitud.SolicitudID"
                                                       name="fechaVencimientoPublicacion"
                                                       type="date"
                                                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                                       value="@(solicitud.FechaVencimientoPublicacion?.ToString("yyyy-MM-dd"))"
                                                       class="form-control form-control-sm"
                                                       aria-label="Fecha de vencimiento de publicación para @solicitud.ConsecutivoOficio" />
                                                <div class="d-flex flex-wrap gap-1">
                                                    <button type="submit"
                                                            name="publicar"
                                                            value="true"
                                                            class="btn btn-outline-success btn-sm">
                                                        @(solicitud.Publicado ? "Guardar publicación" : "Publicar")
                                                    </button>
                                                    @if (solicitud.Publicado)
                                                    {
                                                        <button type="submit"
                                                                name="publicar"
                                                                value="false"
                                                                class="btn btn-outline-secondary btn-sm">
                                                            Retirar
                                                        </button>
                                                    }
                                                </div>
                                            </form>

                                            <a asp-page="/Tareas/Index"
                                               asp-route-solicitudId="@solicitud.SolicitudID"
                                               class="btn btn-outline-primary btn-sm"
                                               title="Ver tareas">
                                                <i class="bi bi-check2-square me-1"></i>
                                                Tareas
                                            </a>

                                            <a asp-page="/Desgloses/Index"
                                               asp-route-solicitudId="@solicitud.SolicitudID"
                                               class="btn btn-outline-primary btn-sm"
                                               title="Ver desglose">
                                                <i class="bi bi-cash-stack me-1"></i>
                                                Desglose
                                            </a>

                                            <a asp-page="/Propuestas/Index"
                                               asp-route-solicitudId="@solicitud.SolicitudID"
                                               class="btn btn-outline-primary btn-sm"
                                               title="Ver participaciones propuestas">
                                                <i class="bi bi-people me-1"></i>
                                                Participaciones
                                            </a>

                                            <a asp-page="/Solicitudes/Edit"
                                               asp-route-id="@solicitud.SolicitudID"
                                               class="btn btn-outline-secondary btn-sm"
                                               title="Editar solicitud">
                                                <i class="bi bi-pencil-square me-1"></i>
                                                Editar
                                            </a>

                                            <form method="post"
                                                  asp-page-handler="Eliminar"
                                                  asp-route-id="@solicitud.SolicitudID"
                                                  asp-route-pagina="@Model.Pagina"
                                                  onsubmit="return confirm('¿Deseas eliminar esta solicitud?');">
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                        title="Eliminar solicitud">
                                                    <i class="bi bi-trash me-1"></i>
                                                    Eliminar
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (Model.TotalPaginas > 0)
            {
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
                    <span class="text-muted small">
                        Página @Model.Pagina de @Model.TotalPaginas
                    </span>

                    <nav aria-label="Paginación de solicitudes">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="/Solicitudes/Index"
                                   asp-route-pagina="@(Model.Pagina - 1)">
                                    <i class="bi bi-chevron-left me-1"></i>
                                    Anterior
                                </a>
                            </li>

                            @for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++)
                            {
                                <li class="page-item @(pagina == Model.Pagina ? "active" : "")">
                                    <a class="page-link"
                                       asp-page="/Solicitudes/Index"
                                       asp-route-pagina="@pagina">
                                        @pagina
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.Pagina >= Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link"
                                   asp-page="/Solicitudes/Index"
                                   asp-route-pagina="@(Model.Pagina + 1)">
                                    Siguiente
                                    <i class="bi bi-chevron-right ms-1"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </section>
</div>

<style>
    .pagina-siges .solicitud-titulo {
        min-width: 220px;
        max-width: 340px;
    }

    .pagina-siges .acciones-solicitud {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 0.4rem;
        min-width: 390px;
    }

    .pagina-siges .publicacion-solicitud {
        display: grid;
        gap: 0.35rem;
        min-width: 220px;
        max-width: 250px;
    }

        .pagina-siges .acciones-solicitud form {
            display: inline-flex;
            margin: 0;
        }

        .pagina-siges .acciones-solicitud .btn {
            white-space: nowrap;
        }

    .pagina-siges .table td {
        vertical-align: middle;
    }
    @@media (max-width: 768px) {
        .pagina-siges .tarjeta-siges-body {
            padding: 0.85rem;
        }

        .pagina-siges .acciones-solicitud {
            min-width: 280px;
        }

        .pagina-siges .publicacion-solicitud {
            min-width: 210px;
        }
    }

</style>
