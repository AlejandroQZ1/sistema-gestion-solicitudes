
@page "{id:int}"
@model AdministracionSoluciones.Pages.Solicitudes.EditModel

@{
    ViewData["Title"] = "Editar solicitud";
}

<div class="container-fluid pagina-siges">
    <div class="mb-4">
        <h2 class="h3 mb-1">Editar solicitud</h2>
        <p class="text-muted mb-0">
            Modifique los datos necesarios y guarde los cambios.
        </p>
    </div>

    <div class="tarjeta-siges">
        <div class="p-3">
            <h3 class="h5 mb-0">Información de la solicitud</h3>
            <small class="text-muted">Los campos marcados con * son obligatorios.</small>
        </div>

        <div class="p-3">
            <form method="post" asp-route-id="@Model.Solicitud.SolicitudID"
                  id="formSolicitud">
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger" role="alert"></div>

                <input asp-for="Solicitud.SolicitudID" type="hidden" />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Solicitud.ConsecutivoOficio" class="form-label">
                            Consecutivo de oficio *
                        </label>
                        <input asp-for="Solicitud.ConsecutivoOficio"
                               class="form-control" maxlength="100" required />
                        <span asp-validation-for="Solicitud.ConsecutivoOficio"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Solicitud.Titulo" class="form-label">
                            Título *
                        </label>
                        <input asp-for="Solicitud.Titulo"
                               class="form-control" maxlength="200" required />
                        <span asp-validation-for="Solicitud.Titulo"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Solicitud.Descripcion" class="form-label">
                            Descripción
                        </label>
                        <textarea asp-for="Solicitud.Descripcion"
                                  class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Solicitud.Descripcion"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Solicitud.RepresentanteID" class="form-label">
                            Representante
                        </label>
                        <select asp-for="Solicitud.RepresentanteID" class="form-select">
                            <option value="">Sin asignar</option>
                            @foreach (var representante in Model.Representantes)
                            {
                                <option value="@representante.Id">
                                    @representante.Nombre
                                </option>
                            }
                        </select>
                        <span asp-validation-for="Solicitud.RepresentanteID"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Solicitud.EstadoSolicitudID" class="form-label">
                            Estado *
                        </label>
                        <select asp-for="Solicitud.EstadoSolicitudID"
                                class="form-select" required>
                            <option value="">Seleccione un estado</option>
                            @foreach (var estado in Model.Estados)
                            {
                                <option value="@estado.Id">@estado.Nombre</option>
                            }
                        </select>
                        <span asp-validation-for="Solicitud.EstadoSolicitudID"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Solicitud.FechaIngreso" class="form-label">
                            Fecha de ingreso *
                        </label>
                        <input asp-for="Solicitud.FechaIngreso"
                               type="date" class="form-control" required />
                        <span asp-validation-for="Solicitud.FechaIngreso"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Solicitud.FechaRespuesta" class="form-label">
                            Fecha de respuesta
                        </label>
                        <input asp-for="Solicitud.FechaRespuesta"
                               type="date" class="form-control" />
                        <span asp-validation-for="Solicitud.FechaRespuesta"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Solicitud.DocumentoRespuesta" class="form-label">
                            Documento de respuesta
                        </label>
                        <input asp-for="Solicitud.DocumentoRespuesta"
                               class="form-control" maxlength="255" />
                        <span asp-validation-for="Solicitud.DocumentoRespuesta"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Solicitud.FechaInicio" class="form-label">
                            Fecha de inicio
                        </label>
                        <input asp-for="Solicitud.FechaInicio"
                               type="date" class="form-control" />
                        <span asp-validation-for="Solicitud.FechaInicio"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Solicitud.DocumentoInicio" class="form-label">
                            Documento de inicio
                        </label>
                        <input asp-for="Solicitud.DocumentoInicio"
                               class="form-control" maxlength="255" />
                        <span asp-validation-for="Solicitud.DocumentoInicio"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Solicitud.Observaciones" class="form-label">
                            Observaciones
                        </label>
                        <textarea asp-for="Solicitud.Observaciones"
                                  class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Solicitud.Observaciones"
                              class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                    <a asp-page="/Solicitudes/Index"
                       class="btn btn-outline-secondary">Cancelar</a>

                    <button type="submit" class="btn btn-primary" id="btnGuardar">
                        <i class="bi bi-save me-1"></i> Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            const form = document.getElementById("formSolicitud");
            const boton = document.getElementById("btnGuardar");

            // Un texto compuesto solo por espacios tampoco cumple el campo obligatorio.
            $(form).find('[name="Solicitud.ConsecutivoOficio"], [name="Solicitud.Titulo"]').each(function () {
                $(this).rules("add", {
                    normalizer: function (value) { return value.trim(); },
                    messages: {
                        required: this.name === "Solicitud.Titulo"
                            ? "El título es obligatorio."
                            : "El consecutivo de oficio es obligatorio."
                    }
                });
            });

            form.addEventListener("submit", function (event) {
                if (!$(form).valid()) {
                    event.preventDefault();
                    return;
                }

                boton.disabled = true;
                boton.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-1"></span> Guardando...';
            });
        });
    </script>
}
