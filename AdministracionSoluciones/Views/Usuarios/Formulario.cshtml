@model UsuarioFormViewModel
@{
    // USR4 - Formulario para crear y actualizar usuarios
    ViewData["Title"] = Model.EsNuevo ? "Nuevo usuario" : "Editar usuario";
    var accion = Model.EsNuevo ? "Crear" : "Editar";
}
<link rel="stylesheet" href="~/css/seguridad.css" asp-append-version="true" />

<div class="seg-encabezado">
    <div>
        <h2>@ViewData["Title"]</h2>
        <p>Todos los datos son requeridos.</p>
    </div>
</div>

<div class="seg-tarjeta seg-formulario">
    <form asp-action="@accion" asp-route-id="@(Model.EsNuevo ? null : Model.Id)" method="post" autocomplete="off" novalidate>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="NombreUsuario" class="form-label"></label>
                <input asp-for="NombreUsuario" class="form-control" />
                <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="NombreCompleto" class="form-label"></label>
                <input asp-for="NombreCompleto" class="form-control" />
                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" type="email" class="form-control" />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Contrasena" class="form-label"></label>
                @if (Model.EsNuevo)
                {
                    <input asp-for="Contrasena" class="form-control" autocomplete="new-password"
                           data-val-required="La contraseña es requerida." />
                }
                else
                {
                    <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                    <div class="form-text">Déjela en blanco para mantener la contraseña actual.</div>
                }
                <span asp-validation-for="Contrasena" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Estado" class="form-label"></label>
                <select asp-for="Estado" class="form-select"
                        asp-items="@(new SelectList(EstadosUsuario.Todos, Model.Estado))"></select>
                <span asp-validation-for="Estado" class="text-danger small"></span>
            </div>
        </div>

        <div class="seg-botones">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn seg-btn-primario">Guardar</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
